{
  "rules": {
    "rooms": {
      ".indexOn": ["updatedAt"],
      "$roomCode": {
        ".read": "auth != null",
        "access": { ".write": false },

        "students": {
          ".write": "auth != null && root.child('rooms').child($roomCode).child('access').child('controllerUid').val() === auth.uid && root.child('rooms').child($roomCode).child('access').child('controllerExpiresAt').val() > now",
          ".validate": "newData.hasChildren() && newData.numChildren() <= 100",
          "$student": { ".validate": "newData.hasChildren(['id', 'name']) && newData.child('name').isString() && newData.child('name').val().length > 0 && newData.child('name').val().length <= 150" }
        },
        "seatingSlots": { ".write": "auth != null && root.child('rooms').child($roomCode).child('access').child('controllerUid').val() === auth.uid && root.child('rooms').child($roomCode).child('access').child('controllerExpiresAt').val() > now" },
        "cols": { ".write": "auth != null && root.child('rooms').child($roomCode).child('access').child('controllerUid').val() === auth.uid && root.child('rooms').child($roomCode).child('access').child('controllerExpiresAt').val() > now" },
        "frontSide": { ".write": "auth != null && root.child('rooms').child($roomCode).child('access').child('controllerUid').val() === auth.uid && root.child('rooms').child($roomCode).child('access').child('controllerExpiresAt').val() > now" },
        "docket": { ".write": "auth != null && root.child('rooms').child($roomCode).child('access').child('controllerUid').val() === auth.uid && root.child('rooms').child($roomCode).child('access').child('controllerExpiresAt').val() > now", ".validate": "newData.numChildren() <= 100" },
        "legislationPack": { ".write": "auth != null && root.child('rooms').child($roomCode).child('access').child('controllerUid').val() === auth.uid && root.child('rooms').child($roomCode).child('access').child('controllerExpiresAt').val() > now", ".validate": "newData.numChildren() <= 100" },
        "poName": { ".write": "auth != null && root.child('rooms').child($roomCode).child('access').child('controllerUid').val() === auth.uid && root.child('rooms').child($roomCode).child('access').child('controllerExpiresAt').val() > now", ".validate": "newData.isString() && newData.val().length <= 150" },
        "roomName": { ".write": "auth != null && root.child('rooms').child($roomCode).child('access').child('controllerUid').val() === auth.uid && root.child('rooms').child($roomCode).child('access').child('controllerExpiresAt').val() > now", ".validate": "newData.isString() && newData.val().length <= 150" },
        "mode": { ".write": "auth != null && root.child('rooms').child($roomCode).child('access').child('controllerUid').val() === auth.uid && root.child('rooms').child($roomCode).child('access').child('controllerExpiresAt').val() > now", ".validate": "newData.val() === 'speech' || newData.val() === 'question'" },
        "seekers": { ".write": "auth != null && root.child('rooms').child($roomCode).child('access').child('controllerUid').val() === auth.uid && root.child('rooms').child($roomCode).child('access').child('controllerExpiresAt').val() > now", ".validate": "newData.numChildren() <= 100" },
        "speechCounter": { ".write": "auth != null && root.child('rooms').child($roomCode).child('access').child('controllerUid').val() === auth.uid && root.child('rooms').child($roomCode).child('access').child('controllerExpiresAt').val() > now", ".validate": "newData.isNumber() && newData.val() >= 0" },
        "questionCounter": { ".write": "auth != null && root.child('rooms').child($roomCode).child('access').child('controllerUid').val() === auth.uid && root.child('rooms').child($roomCode).child('access').child('controllerExpiresAt').val() > now", ".validate": "newData.isNumber() && newData.val() >= 0" },
        "history": { ".write": "auth != null && root.child('rooms').child($roomCode).child('access').child('controllerUid').val() === auth.uid && root.child('rooms').child($roomCode).child('access').child('controllerExpiresAt').val() > now", ".validate": "newData.numChildren() <= 2000" },
        "activeSpeech": { ".write": "auth != null && root.child('rooms').child($roomCode).child('access').child('controllerUid').val() === auth.uid && root.child('rooms').child($roomCode).child('access').child('controllerExpiresAt').val() > now" },
        "currentBillIdx": { ".write": "auth != null && root.child('rooms').child($roomCode).child('access').child('controllerUid').val() === auth.uid && root.child('rooms').child($roomCode).child('access').child('controllerExpiresAt').val() > now" },
        "speechStartTime": { ".write": "auth != null && root.child('rooms').child($roomCode).child('access').child('controllerUid').val() === auth.uid && root.child('rooms').child($roomCode).child('access').child('controllerExpiresAt').val() > now" },
        "affCount": { ".write": "auth != null && root.child('rooms').child($roomCode).child('access').child('controllerUid').val() === auth.uid && root.child('rooms').child($roomCode).child('access').child('controllerExpiresAt').val() > now" },
        "negCount": { ".write": "auth != null && root.child('rooms').child($roomCode).child('access').child('controllerUid').val() === auth.uid && root.child('rooms').child($roomCode).child('access').child('controllerExpiresAt').val() > now" },
        "speechSequence": { ".write": "auth != null && root.child('rooms').child($roomCode).child('access').child('controllerUid').val() === auth.uid && root.child('rooms').child($roomCode).child('access').child('controllerExpiresAt').val() > now" },
        "inQuestionPeriod": { ".write": "auth != null && root.child('rooms').child($roomCode).child('access').child('controllerUid').val() === auth.uid && root.child('rooms').child($roomCode).child('access').child('controllerExpiresAt').val() > now" },
        "questionPrec": { ".write": "auth != null && root.child('rooms').child($roomCode).child('access').child('controllerUid').val() === auth.uid && root.child('rooms').child($roomCode).child('access').child('controllerExpiresAt').val() > now" },
        "poStudentId": { ".write": "auth != null && root.child('rooms').child($roomCode).child('access').child('controllerUid').val() === auth.uid && root.child('rooms').child($roomCode).child('access').child('controllerExpiresAt').val() > now" },
        "roundComplete": { ".write": "auth != null && root.child('rooms').child($roomCode).child('access').child('controllerUid').val() === auth.uid && root.child('rooms').child($roomCode).child('access').child('controllerExpiresAt').val() > now" },
        "updatedAt": { ".write": "auth != null && root.child('rooms').child($roomCode).child('access').child('controllerUid').val() === auth.uid && root.child('rooms').child($roomCode).child('access').child('controllerExpiresAt').val() > now" },
        "speechElapsed": { ".write": "auth != null && root.child('rooms').child($roomCode).child('access').child('controllerUid').val() === auth.uid && root.child('rooms').child($roomCode).child('access').child('controllerExpiresAt').val() > now" },
        "lastSpeakerId": { ".write": "auth != null && root.child('rooms').child($roomCode).child('access').child('controllerUid').val() === auth.uid && root.child('rooms').child($roomCode).child('access').child('controllerExpiresAt').val() > now" },
        "questionBlockNum": { ".write": "auth != null && root.child('rooms').child($roomCode).child('access').child('controllerUid').val() === auth.uid && root.child('rooms').child($roomCode).child('access').child('controllerExpiresAt').val() > now" },
        "docketAdopted": { ".write": "auth != null && root.child('rooms').child($roomCode).child('access').child('controllerUid').val() === auth.uid && root.child('rooms').child($roomCode).child('access').child('controllerExpiresAt').val() > now" },
        "manualSplits": { ".write": "auth != null && root.child('rooms').child($roomCode).child('access').child('controllerUid').val() === auth.uid && root.child('rooms').child($roomCode).child('access').child('controllerExpiresAt').val() > now" },

        "poHeartbeat": {
          ".write": "auth != null && root.child('rooms').child($roomCode).child('access').child('controllerUid').val() === auth.uid && root.child('rooms').child($roomCode).child('access').child('controllerExpiresAt').val() > now",
          ".validate": "!newData.exists() || (newData.child('uid').val() === auth.uid && newData.child('ts').isNumber())"
        },
        "competitorClaims": {
          "$studentKey": {
            ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid) || data.child('uid').val() === auth.uid || (data.child('claimedAt').isNumber() && data.child('claimedAt').val() < now - 45000 && newData.child('uid').val() === auth.uid))",
            ".validate": "newData.hasChildren(['claimedAt', 'uid']) && newData.child('uid').val() === auth.uid && newData.child('claimedAt').isNumber() && newData.child('claimedAt').val() <= now + 10000 && newData.child('claimedAt').val() >= now - 10000"
          }
        },
        "splits": {
          "$studentKey": {
            "$billKey": {
              ".write": "auth != null && root.child('rooms').child($roomCode).child('competitorClaims').child($studentKey).child('uid').val() === auth.uid",
              ".validate": "!newData.exists() || newData.val() === 'aff' || newData.val() === 'neg' || newData.val() === 'both'"
            }
          }
        },
        "competitorIntents": {
          "$studentKey": {
            "speech": {
              ".write": "auth != null && root.child('rooms').child($roomCode).child('competitorClaims').child($studentKey).child('uid').val() === auth.uid",
              ".validate": "newData.isBoolean()"
            }
          }
        },
        "docketProposals": {
          "$studentKey": {
            ".write": "auth != null && root.child('rooms').child($roomCode).child('competitorClaims').child($studentKey).child('uid').val() === auth.uid",
            ".validate": "!newData.exists() || (newData.child('uid').val() === auth.uid && newData.child('name').isString() && newData.child('name').val().length > 0 && newData.child('name').val().length <= 150 && newData.child('submittedAt').isNumber() && newData.child('bills').hasChildren() && newData.child('bills').numChildren() <= 100)"
          }
        },
        "spectatorPresence": {
          "$specId": {
            ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid) || data.child('uid').val() === auth.uid)",
            ".validate": "!newData.exists() || (newData.child('uid').val() === auth.uid && newData.child('heartbeat').isNumber() && newData.child('heartbeat').val() <= now + 10000 && newData.child('heartbeat').val() >= now - 10000)"
          }
        },
        "$other": { ".write": false }
      }
    },
    "roomSecrets": {
      ".indexOn": ["reservedAt"],
      "$roomCode": { ".read": false, ".write": false }
    },
    ".read": false,
    ".write": false
  }
}
